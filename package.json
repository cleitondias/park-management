{
  "name": "park-management",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@sap/cds": "^9.3.1",
    "@sap/cds-dk": "^9.3.0",
    "express": "^4"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.13.0",
    "@cap-js/sqlite": "^2.0.2",
    "@sap/cds-dk": ">=8",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "undeploy": "cf undeploy recap-workshop-2025 --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives gen && npx cds build && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-parkinglot": "cds watch --open parking-lot/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-parking-lot": "cds watch --open parking-lot/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-vehicles": "cds watch --open vehicles/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "mcpServers": {
    "cds-mcp": {
      "command": "cds-mcp",
      "args": [],
      "env": {}
    }
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      }
    },
    "build": {
      "tasks": [
        {
          "for": "hana",
          "src": "db",
          "options": {
            "model": [
              "db",
              "srv"
            ]
          }
        },
        {
          "for": "node-cf"
        }
      ]
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/parking-lot",
    "app/vehicles"
  ]
}
